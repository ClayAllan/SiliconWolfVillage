DEEPSEEK_API_KEY=your_key_here
BASE_URL=https://api.deepseek.com
GOOD_CAMP_MODEL=deepseek-flash
WOLF_CAMP_MODEL=deepseek-flash
TEMPERATURE=0.8
AGENT_TIMEOUT=180

# Public deployments allow these exact HTTPS hostnames by default.
# Add trusted custom OpenAI-compatible provider hostnames as a comma-separated list.
SWV_ALLOWED_MODEL_HOSTS=api.deepseek.com,api.openai.com

# Request cap shared by all sessions in one Python process.
SWV_MAX_CONCURRENT_MODEL_REQUESTS=24

# Trusted local/self-hosted development only; NEVER enable on a public deployment.
# Allows localhost/private-network model endpoints such as local Ollama.
SWV_ALLOW_PRIVATE_MODEL_URLS=0
